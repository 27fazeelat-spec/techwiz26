# Copy this file to .env and fill in real values. Never commit .env.
# This template is committed to the repository: keep every value here a placeholder.

# Flask session signing key - use a long random string
SECRET_KEY=change-me

# PostgreSQL connection (pure-Python pg8000 driver). Leave empty to use a local SQLite file for development.
# Example (local PostgreSQL): postgresql://postgres:<password>@localhost:5432/skillsprint
DATABASE_URL=
# A database on another machine is always reached over verified TLS. If its server certificate is not signed by a
# public CA, save the server's CA certificate in config/ and point to it here. Leave empty for a local database.
DATABASE_SSL_ROOT_CERT=

# Optional: a separate, EMPTY database for the test suite (tests drop and recreate all tables)
TEST_DATABASE_URL=

# Gemini API - create a key in Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=

# Uploads
MAX_UPLOAD_MB=15

# Password given to seeded demo accounts. Leave empty to generate random passwords at seed time.
SEED_PASSWORD=

# Override "today" for demos and tests (YYYY-MM-DD). Leave empty in production.
SKILLSPRINT_TODAY=
