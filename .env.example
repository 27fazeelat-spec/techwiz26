SECRET_KEY=change-me

# Example (local PostgreSQL): postgresql://postgres:<password>@localhost:5432/skillsprint
DATABASE_URL=
DATABASE_SSL_ROOT_CERT=

# Optional: a separate, EMPTY database for the test suite (tests drop and recreate all tables)
TEST_DATABASE_URL=

# Gemini API - create a key in Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=

# Uploads
MAX_UPLOAD_MB=15

# Password given to seeded demo accounts. Leave empty to generate random passwords at seed time.
SEED_PASSWORD=

# Override "today" for demos and tests (YYYY-MM-DD). Leave empty in production.
SKILLSPRINT_TODAY=
