# Copy this file to .env and fill in real values. Never commit .env.
# This template is committed to the repository: keep every value here a placeholder.

# Flask session signing key - use a long random string
SECRET_KEY=change-me

# PostgreSQL connection (pure-Python pg8000 driver). Leave empty to use a local SQLite file for development.
# Example: postgresql://<user>:<password>@<host>:5432/<database>
# Supabase: use the Session pooler string (host aws-...pooler.supabase.com, user postgres.<project-ref>);
# the direct db.<project-ref>.supabase.co host is IPv6-only.
DATABASE_URL=
# TLS for remote databases is always verified. Supabase: download its CA certificate
# (Project Settings > Database > SSL Configuration) and point to it here.
DATABASE_SSL_ROOT_CERT=config/prod-ca-2021.crt

# Optional: a separate, EMPTY database for the test suite (tests drop and recreate all tables)
TEST_DATABASE_URL=

# Gemini API - create a key in Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=

# Uploads
MAX_UPLOAD_MB=15

# Password given to seeded demo accounts. Leave empty to generate random passwords at seed time.
SEED_PASSWORD=

# Override "today" for demos and tests (YYYY-MM-DD). Leave empty in production.
SKILLSPRINT_TODAY=
